; L'Ordre Caché — a small, experimental 2D puzzle adventure.
config_version=5

[application]
config/name="L'Ordre Caché"
config/description="Un monde mystérieux dont les lois se découvrent par l'expérimentation."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/version="0.1.0"
config/auto_accept_quit=true

[display]
window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.027, 0.043, 0.078, 1)

[audio]

[gui]
theme/default_font_multichannel_signed_distance_field=true

[debug]
gdscript/warnings/untyped_declaration=1
